<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ════════════════════════════════════════════════════════
         BASE APPLICATION THEME — Premium Dark-Accent B2B India
         ════════════════════════════════════════════════════════ -->
    <style name="Theme.B2BIndia" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent_gold</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/toolbar_start</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/bottom_nav_bg</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- Material You ripple color -->
        <item name="rippleColor">@color/primary_light</item>
        <item name="materialButtonStyle">@style/Widget.B2BIndia.Button</item>
        <item name="bottomNavigationStyle">@style/Widget.B2BIndia.BottomNavigation</item>
    </style>

    <!-- Premium Button Style -->
    <style name="Widget.B2BIndia.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="elevation">2dp</item>
    </style>

    <!-- Outlined Button Style -->
    <style name="Widget.B2BIndia.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="strokeColor">@color/primary</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <!-- Bottom Navigation Style -->
    <style name="Widget.B2BIndia.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/bottom_nav_bg</item>
        <item name="itemIconTint">@color/bottom_nav_icon_colors</item>
        <item name="itemTextColor">@color/bottom_nav_icon_colors</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <!-- Card Style -->
    <style name="Widget.B2BIndia.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>

    <!-- Toolbar Title — no subtitle collision fix -->
    <style name="Widget.B2BIndia.Toolbar.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- ════════════════════════════════════════════════════════
         SPLASH SCREEN THEME — Full bleed dark gradient
         ════════════════════════════════════════════════════════ -->
    <style name="Theme.B2BIndia.Splash" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg_start</item>
        <item name="android:statusBarColor">@color/splash_bg_start</item>
        <item name="android:navigationBarColor">@color/splash_bg_start</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>

</resources>
